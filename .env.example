# ==============================================================================
# VARIABLES DE ENTORNO PARA GYMTRACK (PYTHON / FASTAPI + SUPABASE AUTH)
# ==============================================================================

PORT=3000
HOST=0.0.0.0

# 1. Credenciales públicas de Supabase (Project Settings -> API)
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_ANON_KEY=tu-anon-o-publishable-key
# Alias de compatibilidad (debe ser SIEMPRE la clave anon/publishable, NUNCA service_role)
SUPABASE_KEY=tu-anon-o-publishable-key

# 2. Clave administrativa de Supabase (SOLO BACKEND — NUNCA EXPONER EN FRONTEND)
# NUNCA colocarla en variables públicas (SUPABASE_ANON_KEY / VITE_*).
# Se utiliza exclusivamente desde el servidor para operaciones Auth admin y tablas
# privadas con RLS sin permisos a `anon`/`authenticated` (ej. `public.integracion_pago_gimnasio`).
SUPABASE_SERVICE_ROLE_KEY=

# 3. Verificación criptográfica de JWT emitidos por Supabase Auth
# Por defecto se autoderivan de SUPABASE_URL:
#   SUPABASE_JWT_ISSUER = ${SUPABASE_URL}/auth/v1
#   SUPABASE_JWKS_URL   = ${SUPABASE_URL}/auth/v1/.well-known/jwks.json
SUPABASE_JWT_ISSUER=
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWKS_URL=
# Opcionales según el método de firma configurado en Supabase Auth (ES256/RS256/HS256):
SUPABASE_JWT_PUBLIC_KEY=
SUPABASE_JWT_SECRET=
SUPABASE_JWT_ALGORITHMS=ES256,RS256,HS256

# 4. Compatibilidad con variables frontend (Vite)
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=tu-anon-o-publishable-key

# 5. Mercado Pago OAuth oficial por gimnasio (SOLO BACKEND — NUNCA EXPONER EN FRONTEND)
# Obtener Client ID y Client Secret en Mercado Pago Developers -> Tus integraciones -> Credenciales
MERCADOPAGO_CLIENT_ID=
MERCADOPAGO_CLIENT_SECRET=
# Debe coincidir exactamente con la Redirect URI registrada en Mercado Pago Developers
# Ejemplo local: http://localhost:3000/api/integraciones/mercadopago/callback
# Ejemplo Render: https://tu-backend.onrender.com/api/integraciones/mercadopago/callback
MERCADOPAGO_REDIRECT_URI=
# Clave Fernet válida (32 bytes en base64 url-safe). Generar con:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MERCADOPAGO_TOKEN_ENCRYPTION_KEY=
# Opcional: secreto dedicado para firmar el parámetro `state` OAuth (si se omite, se deriva con HMAC)
MERCADOPAGO_STATE_SECRET=

# Token heredado/opcional (NO usado para OAuth por gimnasio)
MERCADOPAGO_ACCESS_TOKEN=
Token_Mer=
Api_MER=

# 6. Ualá Bis (Opcional)
UALA_CLIENT_ID=
UALA_CLIENT_SECRET=

# 7. URL del Frontend (CORS y redirecciones)
FRONTEND_URL=http://localhost:5173
